<Window x:Class="EgeTracker.Views.ExamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/app.ico"
        Title="Exam Mode"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource BrushBackground}">

    <Grid>
        <!-- ========== ЭКРАН 1: ВЫБОР ========== -->
        <Grid Visibility="{Binding IsSelectScreen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource CardStyle}"
                    MaxWidth="620"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="🎯 РЕЖИМ ЕГЭ"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>

                    <TextBlock Text="Выберите предмет для прохождения экзамена. Вариант формируется автоматически из банка ФИПИ."
                               TextWrapping="Wrap"
                               FontSize="13" Margin="0,8,0,20"
                               Foreground="{DynamicResource BrushTextSecondary}"/>

                    <TextBlock Text="Предмет:"
                               FontWeight="SemiBold" Margin="0,0,0,6"
                               Foreground="{DynamicResource BrushTextPrimary}"/>

                    <ComboBox ItemsSource="{Binding AvailableSubjects}"
                              SelectedItem="{Binding SelectedSubject}"
                              DisplayMemberPath="Name"
                              Height="40"
                              Style="{StaticResource ModernComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}"/>

                    <!-- Информационная панель -->
                    <Border Background="{DynamicResource BrushSurfaceAlt}"
                            CornerRadius="8" Padding="14" Margin="0,16,0,0"
                            Visibility="{Binding ShowInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding InfoText}"
                                   TextWrapping="Wrap" FontSize="12"
                                   LineHeight="20"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="ℹ Информация о предметах"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ShowInfoCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="Отмена"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CloseCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="Начать решение"
                                Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding StartExamCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========== ЭКРАН 2: ЭКЗАМЕН ========== -->
        <Grid Visibility="{Binding IsExamScreen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель с таймером -->
            <Border Grid.Row="0" Background="{DynamicResource BrushSurface}" Padding="20,12">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="EXAM MODE"
                                   FontWeight="Bold" FontSize="18"
                                   Foreground="{DynamicResource BrushAccent}"/>
                        <TextBlock Text="{Binding SubjectName, StringFormat=' · {0}'}"
                                   FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding TimerText}"
                               FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Right"
                               Foreground="{Binding TimerColor}"/>
                </Grid>
            </Border>

            <!-- Задания -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Border Background="{DynamicResource BrushAccent}"
                                            CornerRadius="6" Padding="10,4"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Task.KimPosition, StringFormat=Задание № {0}}"
                                                   Foreground="White" FontWeight="Bold"/>
                                    </Border>

                                    <TextBlock Text="{Binding Task.Question}"
                                               TextWrapping="Wrap" LineHeight="22" FontSize="15"
                                               Margin="0,10,0,0"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>

                                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                             Width="320" HorizontalAlignment="Left"
                                             Margin="0,10,0,0"
                                             Text="{Binding UserAnswer, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Нижняя панель: инструменты + завершение -->
            <Border Grid.Row="2" Background="{DynamicResource BrushSurface}" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                Visibility="{Binding IsInformatics, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Инструменты:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>

                        <Button Content="🐍 Python (VS Code)"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6" Margin="0,0,8,0"
                                Command="{Binding LaunchVsCodeCommand}"/>

                        <Button Content="📊 Excel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6" Margin="0,0,8,0"
                                Command="{Binding LaunchExcelCommand}"/>

                        <Button Content="📝 Блокнот"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6" Margin="0,0,8,0"
                                Command="{Binding LaunchNotepadCommand}"/>

                        <Button Content="🧮 Калькулятор"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6" Margin="0,0,8,0"
                                Command="{Binding LaunchCalculatorCommand}"/>

                        <Button Content="🎨 Paint"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6"
                                Command="{Binding LaunchPaintCommand}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="✓ Сдать на проверку"
                            Style="{StaticResource DangerButtonStyle}"
                            FontSize="15" Padding="20,10"
                            Command="{Binding FinishExamCommand}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ========== ЭКРАН 3: РЕЗУЛЬТАТЫ ========== -->
        <Grid Visibility="{Binding IsResultsScreen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource BrushSurface}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="📊 РЕЗУЛЬТАТЫ ЭКЗАМЕНА"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding ResultSummary}"
                               FontSize="16" Margin="0,8,0,0"
                               Foreground="{DynamicResource BrushAccent}"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <ItemsControl ItemsSource="{Binding ResultRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayHeader}"
                                               FontWeight="Bold" FontSize="14"
                                               VerticalAlignment="Center"
                                               MinWidth="120"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayAnswers}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Status}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding StatusColor}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource BrushSurface}" Padding="20,12">
                <Button Content="Вернуться в приложение"
                        Style="{StaticResource ModernButtonStyle}"
                        HorizontalAlignment="Right"
                        Command="{Binding CloseCommand}"/>
            </Border>
        </Grid>
    </Grid>
</Window>