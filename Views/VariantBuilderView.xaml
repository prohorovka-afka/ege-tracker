<UserControl x:Class="EgeTracker.Views.VariantBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Предмет:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource BrushTextPrimary}"/>

                <ComboBox Width="260"
                          ItemsSource="{Binding Subjects}"
                          SelectedItem="{Binding SelectedSubject}"
                          DisplayMemberPath="Name"
                          Margin="0,0,16,0"
                          Style="{StaticResource ModernComboBoxStyle}"
                          ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}"/>

                <Button Content="✔ Выбрать все"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding SelectAllCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="✘ Снять все"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ClearAllCommand}"/>
            </StackPanel>
        </Border>

        <!-- Список номеров с чекбоксами и счётчиками -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Отметьте задания, которые должны войти в вариант:"
                           FontSize="14"
                           Margin="0,0,0,12"
                           Foreground="{DynamicResource BrushTextSecondary}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TaskNumbers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}"
                                        Padding="12,10"
                                        Margin="4"
                                        MinWidth="220">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Чекбокс -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>

                                        <!-- Название -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayText}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>

                                        <!-- ⭐ Счётчик заданий у номера -->
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource BrushSurfaceAlt}"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AvailableCount}"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource BrushAccent}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Нижняя панель: итоги + кнопка -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource BrushTextPrimary}"
                               FontSize="13">
                        <Run Text="Всего заданий в базе: "/>
                        <Run Text="{Binding TotalAvailable, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource BrushTextSecondary}"
                               FontSize="12" Margin="0,4,0,0">
                        <Run Text="Отмечено номеров: "/>
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="   ·   Размер варианта: "/>
                        <Run Text="{Binding VariantSize, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text=" заданий"/>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="📋 Составить вариант"
                        Style="{StaticResource ModernButtonStyle}"
                        Command="{Binding BuildCommand}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>