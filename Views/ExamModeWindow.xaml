<Window x:Class="EgeTracker.Views.ExamModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/app.ico"
        Title="Exam Mode"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Topmost="True"
        Background="{DynamicResource BrushBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BrushSurface}" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="EXAM MODE" FontWeight="Bold" FontSize="18"
                               Foreground="{DynamicResource BrushAccent}"/>
                    <TextBlock Text="{Binding SubjectName, StringFormat=' · {0}'}"
                               FontSize="16" FontWeight="SemiBold"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding VariantNumber, StringFormat=' · Variant {0}'}"
                               FontSize="16" Margin="8,0,0,0"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>

                <TextBlock Text="{Binding TimerText}"
                           FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource BrushAccent}"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <Border Background="{DynamicResource BrushAccent}"
                                        CornerRadius="6" Padding="10,4"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Task.KimPosition, StringFormat=Task {0}}"
                                               Foreground="White" FontWeight="Bold"/>
                                </Border>

                                <TextBlock Text="{Binding Task.Question}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"
                                           LineHeight="22" FontSize="15"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>

                                <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                         Width="320" HorizontalAlignment="Left"
                                         Margin="0,10,0,0"
                                         Text="{Binding UserAnswer, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource BrushSurface}" Padding="20,12">
            <Grid>
                <TextBlock Text="{Binding ResultText}"
                           VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Button Content="Finish Exam"
                        Style="{StaticResource DangerButtonStyle}"
                        HorizontalAlignment="Right"
                        Click="OnFinishClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>