<UserControl x:Class="EgeTracker.Views.HomePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EgeTracker.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Приветствие -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding TodayText}"
                               FontSize="14" Margin="0,6,0,0"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding CountdownText}"
                               FontSize="16" FontWeight="SemiBold"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource BrushAccent}"/>
                    <TextBlock Text="{Binding MotivationText}"
                               FontSize="13" FontStyle="Italic"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>

            <!-- ⭐ Последние действия -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding HasLastAction, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🔄 Продолжить"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="{Binding LastActionText}"
                                   FontSize="13" Margin="0,4,0,0"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="▶ Продолжить"
                            Style="{StaticResource ModernButtonStyle}"
                            Command="{Binding ContinueLastCommand}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Быстрый доступ -->
            <TextBlock Text="Быстрый доступ"
                       FontSize="18" FontWeight="Bold"
                       Margin="0,4,0,8"
                       Foreground="{DynamicResource BrushTextPrimary}"/>

            <ItemsControl ItemsSource="{Binding QuickCards}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="200" Height="110" Margin="0,0,12,12"
                                Cursor="Hand"
                                Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding DataContext.NavigateCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Key}">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Icon}" FontSize="26"/>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="15" FontWeight="Bold"
                                           Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="11" Opacity="0.85"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Прогресс по предметам -->
            <TextBlock Text="Прогресс по предметам"
                       FontSize="18" FontWeight="Bold"
                       Margin="0,4,0,8"
                       Foreground="{DynamicResource BrushTextPrimary}"/>

            <Border Style="{StaticResource CardStyle}">
                <ItemsControl ItemsSource="{Binding SubjectsProgress}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="160" Margin="8,0,8,8"
                                        HorizontalAlignment="Center">
                                <controls:CircularProgress
                                    Value="{Binding Percent, Mode=OneWay}"
                                    Width="120" Height="120"
                                    HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding DisplayText}"
                                           FontWeight="SemiBold" FontSize="12"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Ранг -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏆 Уровень подготовки"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="{Binding RankName}"
                                   FontSize="16" FontWeight="Bold"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource BrushAccent}"/>
                    </StackPanel>
                    <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                                 Value="{Binding RankProgress, Mode=OneWay}"
                                 Height="14" Margin="0,10,0,6"/>
                    <TextBlock Text="{Binding RankProgressText}"
                               FontSize="12"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>