<Window x:Class="EgeTracker.Views.ExamSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/app.ico"
        Title="Exam Setup"
        Width="500" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBackground}">
    <Border Style="{StaticResource CardStyle}" Margin="20">
        <StackPanel>
            <TextBlock Text="Exam Mode"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource BrushTextPrimary}"/>

            <TextBlock Text="Select subject:"
                       FontSize="13" Margin="0,12,0,8"
                       Foreground="{DynamicResource BrushTextSecondary}"/>

            <ComboBox x:Name="SubjectCombo"
                      Height="36"
                      Style="{StaticResource ModernComboBoxStyle}"
                      ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}"/>

            <TextBlock Text="Variant number:"
                       FontSize="13" Margin="0,16,0,8"
                       Foreground="{DynamicResource BrushTextSecondary}"/>

            <TextBox x:Name="VariantText"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Text="1"/>

            <TextBlock Text="Duration (minutes):"
                       FontSize="13" Margin="0,16,0,8"
                       Foreground="{DynamicResource BrushTextSecondary}"/>

            <TextBox x:Name="DurationText"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Text="235"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnCancelClick"
                        Margin="0,0,8,0"/>
                <Button Content="Start Exam"
                        Style="{StaticResource ModernButtonStyle}"
                        Click="OnStartClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>