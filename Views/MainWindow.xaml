<Window x:Class="EgeTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EgeTracker.ViewModels"
        Title="EgeTracker"
        Width="1200" Height="780"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource BrushBackground}">

        <Image x:Name="BackgroundImage"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Opacity="0.35"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <Rectangle Fill="{DynamicResource BrushBackground}"
                   Opacity="0.55"
                   IsHitTestVisible="False"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSurface}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,20,16,16">
                        <TextBlock Text="EgeTracker" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Self-education" FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                        <Button Content="🎯 Режим ЕГЭ"
                                Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding ExamModeCommand}"
                                Margin="0,0,0,6"/>
                        <Button Content="🎨 Концентрация"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ToggleConcentrationCommand}"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Tabs}" Margin="8,0" Padding="0,4">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,3"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.NavigateCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Key}"
                                        HorizontalContentAlignment="Left"
                                        Padding="14,10"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="ScaleT" ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource BrushSurfaceAlt}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource BrushAccent}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ScaleT"
                                                                                 Storyboard.TargetProperty="ScaleX"
                                                                                 To="0.97" Duration="0:0:0.05"/>
                                                                <DoubleAnimation Storyboard.TargetName="ScaleT"
                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                 To="0.97" Duration="0:0:0.05"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ScaleT"
                                                                                 Storyboard.TargetProperty="ScaleX"
                                                                                 To="1.0" Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="ScaleT"
                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                 To="1.0" Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontSize="16"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <ContentControl x:Name="ContentHost" Grid.Column="1">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="ContentTranslate"/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>
    </Grid>
</Window>