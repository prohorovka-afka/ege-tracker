<UserControl x:Class="EgeTracker.Controls.MarkerCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="✏ Маркер" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="8,4" Margin="0,0,4,0" Click="OnInk"/>
            <Button Content="🧽 Ластик" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="8,4" Margin="0,0,4,0" Click="OnEraser"/>
            <Button Content="✖ Очистить" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="8,4" Margin="0,0,4,0" Click="OnClear"/>
            <Button Content="⏸ Выкл" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="8,4" Click="OnDisable"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <ContentPresenter x:Name="ContentHost"/>
            <InkCanvas x:Name="Canvas"
                       Background="Transparent"
                       IsHitTestVisible="False"
                       EditingMode="None"/>
        </Grid>
    </Grid>
</UserControl>