<UserControl x:Class="EgeTracker.Controls.CircularProgress"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="140" Height="140">
    <Grid>
        <Ellipse Stroke="{DynamicResource BrushSurfaceAlt}" StrokeThickness="12"/>
        <Path x:Name="ArcPath" Stroke="{DynamicResource BrushAccent}"
              StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Fill="Transparent"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="PercentText" Text="0%" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource BrushTextPrimary}"/>
            <TextBlock x:Name="CaptionText" Text="" FontSize="11"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource BrushTextSecondary}"/>
        </StackPanel>
    </Grid>
</UserControl>